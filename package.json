{
  "name": "basalt",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @basalt/web",
    "build": "npm run build -w @basalt/web",
    "start": "npm run start -w @basalt/web",
    "lint": "npm run lint -w @basalt/web",
    "test": "npm test -w @basalt/web",
    "check:build": "npm run check:build -w @basalt/web",
    "worker:build": "cargo build --release -p basalt-cdc",
    "worker:test": "cargo test -p basalt-cdc"
  }
}
