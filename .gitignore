# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
data/
.next-test/
worker/target/

# build output, including test builds
/.next-*/
/dist/

# customer data, warehouses and keys never go in the repo
/data/
*.duckdb
*.duckdb.wal
*.parquet.tmp
*.key
*.p12
*.pfx
*service-account*.json
!.env.example

# Python and dbt
.venv/
venv/
__pycache__/
*.pyc
dbt_packages/
/target/
/logs/

# logs and temp files
*.log
*.tmp

# editors and OS
.vscode/
.idea/
Thumbs.db

# Claude Code local settings
.claude/settings.local.json
