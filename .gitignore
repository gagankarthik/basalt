# Rules have no leading slash where they must match in every package of this monorepo.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output, including test builds
.next/
.next-*/
out/
build/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts

# Rust
target/

# customer data, warehouses and keys never go in the repo
data/
*.duckdb
*.duckdb.wal
*.parquet.tmp
*.pem
*.key
*.p12
*.pfx
*service-account*.json

# env files, except the example
.env*
!.env.example

# Python and dbt
.venv/
venv/
__pycache__/
*.pyc
dbt_packages/
logs/

# logs and temp files
*.log
*.tmp

# hosting tools
.vercel

# editors and OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local settings
.claude/settings.local.json
